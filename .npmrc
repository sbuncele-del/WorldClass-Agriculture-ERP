# Force exact versions when installing new packages
save-exact=true

# Do NOT hard-fail installs on the Node engine range. Render pins Node to 22.x in
# its own dashboard, but Vercel builds this monorepo on Node 24 — engine-strict
# turned the resulting EBADENGINE into a fatal `npm install` error and broke every
# frontend deploy. npm still prints a warning; the pinned range stays documented
# in package.json "engines".
engine-strict=false

# Don't save optional dependencies
save-optional=false

# Use package-lock.json (default for npm 5+)
package-lock=true

# The frontend includes validated React 19 packages with older peer ranges.
# Allow the monorepo install so backend-only Render builds are not blocked.
legacy-peer-deps=true

# Fail on warnings during install
strict-ssl=true

# Production safety
audit=true
fund=false
